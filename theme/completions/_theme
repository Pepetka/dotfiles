#compdef theme

local -a subcmds
subcmds=(
  'auto:Follow system appearance (requires the service)'
  'dark:Persist and apply dark mode'
  'light:Persist and apply light mode'
  'install:Install the engine and system service (--manual, --backend PATH)'
  'uninstall:Remove the engine and service, retaining the last theme'
  'status:Show preference, effective mode and adapter diagnostics'
  'sync:Reapply the selected theme'
  'authorize:Grant the helper permission to reload Ghostty'
)

_describe -t commands 'theme' subcmds
