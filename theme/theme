#!/usr/bin/env bash
set -euo pipefail

theme_source="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
theme_directory="${XDG_CONFIG_HOME:-$HOME/.config}/theme"

case "${1:-help}" in
install|uninstall)
  exec "$theme_source/install.sh" "$@"
  ;;
auto|dark|light|sync|status|authorize)
  if [[ ! -x "$theme_directory/theme-sync" || ! -f "$theme_directory/engine.json" ]]; then
    echo 'Theme engine is not installed. Run: theme install' >&2
    exit 1
  fi
  if [[ "$1" == status && "$(uname -s)" == Darwin ]]; then
    if service_info="$(launchctl print "gui/$(id -u)/com.vlvkuznetsov.theme-sync" 2>/dev/null)"; then
      echo "Service: $(awk '/state = / {print $3; exit}' <<< "$service_info")"
    else
      echo 'Service: not loaded'
    fi
  fi
  exec "$theme_directory/theme-sync" "$1" --theme-dir "$theme_directory" "${@:2}"
  ;;
help|-h|--help)
  echo 'Usage: theme {auto|dark|light|sync|status|authorize|install [--backend PATH]|uninstall}'
  ;;
*)
  echo "Unknown theme command: $1" >&2
  exit 1
  ;;
esac
