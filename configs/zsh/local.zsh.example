# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh.
# Uncomment only what this machine uses. Loaded after the instant prompt, before Oh My Zsh;
# keep it silent: console output here triggers a Powerlevel10k warning.
# Keep secrets in the adjacent secrets.zsh, outside Git. Scripts that register
# completions (they run compinit themselves if loaded earlier) belong in
# local.after.zsh; see local.after.zsh.example.

# Shell preferences
# export EDITOR=nvim
# export ZSH="$HOME/.oh-my-zsh"
# export ZSH_CUSTOM="$ZSH/custom"
# ZSH_THEME="powerlevel10k/powerlevel10k" # Use "" for no theme.
# plugins=(z fzf npm bun sudo docker direnv extract
#   alias-tips autoupdate web-search docker-compose git-auto-fetch
#   zsh-autosuggestions zsh-syntax-highlighting)

# Common user executables (Ubuntu does not need Homebrew).
# path=("$HOME/.local/bin" "$HOME/bin" "$HOME/go/bin" $path)

# Homebrew: choose the actual location on this machine.
# macOS Apple Silicon: /opt/homebrew; Intel: /usr/local
# Linuxbrew: /home/linuxbrew/.linuxbrew
# eval "$(/opt/homebrew/bin/brew shellenv)"
# path=("$HOMEBREW_PREFIX/opt/curl/bin" "$HOMEBREW_PREFIX/opt/libpq/bin" $path)
# export DYLD_FALLBACK_LIBRARY_PATH="$HOMEBREW_PREFIX/lib" # macOS only, if needed.

# NVM (omit the Oh My Zsh nvm plugin when initializing it here).
# export NVM_DIR="$HOME/.nvm"
# [[ ! -s "$NVM_DIR/nvm.sh" ]] || source "$NVM_DIR/nvm.sh"
# [[ -z "$NVM_BIN" ]] || path=("$NVM_BIN" $path)

# Bun: completions come from the Oh My Zsh bun plugin.
# export BUN_INSTALL="$HOME/.bun"
# path=("$BUN_INSTALL/bin" $path)

# Other tools
# path=("$HOME/.kimi-code/bin" $path)
# [[ ! -r "$HOME/.local/bin/env" ]] || source "$HOME/.local/bin/env"
# path+=(/Applications/WezTerm.app/Contents/MacOS) # macOS only

# SDKMAN: initialize it in local.after.zsh.
